# Brasaland API - Environment Variables
# Copy this file to .env and fill in the values

# JWT Secret Key for access tokens
SECRET_KEY=your-secret-key-change-in-production

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT Secret Key for password reset tokens (use a different key than SECRET_KEY)
PASSWORD_RESET_SECRET_KEY=your-password-reset-secret-key

# Password reset token expiration time in minutes
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend API Key (get from https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Resend sender email (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000

# TinyDB database path
SUPPLIERS_DB_PATH=data/suppliers.json
