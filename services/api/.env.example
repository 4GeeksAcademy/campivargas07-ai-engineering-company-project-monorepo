# ============================================================
# Brasaland API — Environment Variables Template
# Copy this file to .env locally: cp .env.example .env
# NEVER commit real credentials to Git.
# ============================================================

# Database URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE

# JWT Security
SECRET_KEY=replace-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password-reset JWT (must differ from SECRET_KEY in production)
PASSWORD_RESET_SECRET_KEY=replace-with-a-different-secret
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend delivery and public backoffice URL
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000

# Development only: include the reset URL in the API response
AUTH_DEBUG_RESET_LINKS=false

# TinyDB path (defaults to data/suppliers.json)
SUPPLIERS_DB_PATH=data/suppliers.json

# Telemetry ingestion endpoint (stub/collector)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Host development; Compose uses redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Knowledge vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Perplexity directo: /v1/embeddings, Bearer, signed INT8 + COSINE
# Alternativa openai_compatible sólo con contrato float del proxy confirmado
EMBEDDING_PROVIDER=perplexity
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENCODING_FORMAT=base64_int8
EMBEDDING_API_BASE_URL=https://api.perplexity.ai/v1
EMBEDDING_MODEL=pplx-embed-v1-0.6b
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30

# Perplexity directo: /v1/agent, sin preset/herramientas, max_steps=1
GENERATION_PROVIDER=perplexity
GENERATION_API_BASE_URL=https://api.perplexity.ai/v1
# creator/model exacto habilitado en tu cuenta (GET /v1/models)
GENERATION_MODEL=
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=45
# Sólo openai_compatible; Perplexity /agent no admite este parámetro
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=500

# Calibrar con evaluación real; no es una probabilidad
KNOWLEDGE_MIN_SCORE=
