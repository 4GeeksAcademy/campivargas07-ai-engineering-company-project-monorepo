# ==========================================
# Brasaland API Service (.env.example)
# ==========================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# JWT Authentication
SECRET_KEY=brasaland-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password Reset Configuration (Optional)
PASSWORD_RESET_SECRET_KEY=brasaland-password-reset-secret-key-min-32-chars
PASSWORD_RESET_EXPIRE_MINUTES=30
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@brasaland.com
FRONTEND_URL=http://localhost:3000

# TinyDB Database Path
SUPPLIERS_DB_PATH=data/suppliers.json

