# ============================================================
# Brasaland API — Environment Variables Template
# Copy this file to .env locally: cp .env.example .env
# NEVER commit real credentials to Git.
# ============================================================

# Database URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE

# JWT Security
SECRET_KEY=replace-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password-reset JWT (must differ from SECRET_KEY in production)
PASSWORD_RESET_SECRET_KEY=replace-with-a-different-secret
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend delivery and public backoffice URL
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000

# Development only: include the reset URL in the API response
AUTH_DEBUG_RESET_LINKS=false

# TinyDB path (defaults to data/suppliers.json)
SUPPLIERS_DB_PATH=data/suppliers.json

# Telemetry ingestion endpoint (stub/collector)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Rate limiting (per process, in-memory). Disabled automatically when BRASALAND_ENV=test.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_TELEMETRY_PER_MINUTE=60
# RATE_LIMIT_AGENT_PER_MINUTE=20
# RATE_LIMIT_KNOWLEDGE_PER_MINUTE=30

# RAG — Google Gemini OpenAI-compatible configuration (embeddings-chat-v1).
# Set RAG_EMBEDDING_API_KEY (a single Gemini API key serves both embeddings and generation).
RAG_HTTP_CONTRACT=embeddings-chat-v1
RAG_EMBEDDING_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSION=768
RAG_EMBEDDING_ENCODING=float
RAG_GENERATION_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
RAG_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_GENERATION_API_KEY=
# Calibrated threshold separating in-scope (>= 0.6170) from out-of-scope (<= 0.5637)
RAG_MIN_SCORE=0.60
RAG_TIMEOUT_SECONDS=30
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Agent memory (MEM-092). Empty allowlist = deny-all until official BRIEFING policy.
AGENT_MEMORY_DB_PATH=
AGENT_MEMORY_ALLOWED_CATEGORIES=

# Chat WebSocket — checkpoint durable opcional (sqlite:///chat_checkpoints.sqlite o postgres://...)
CHAT_CHECKPOINT_DB_URL=

# RFP Parte 2 — generación y evaluación de respuestas por departamento
RFP_GENERATION_URL=
RFP_GENERATION_MODEL=
RFP_GENERATION_API_KEY=
RFP_GENERATION_TIMEOUT_SECONDS=30
RFP_MAX_ITERATIONS=3
# Conversión monetaria opcional con trazabilidad (USD -> COP). Si está vacío, no se convierte.
RFP_FX_RATE_USD_COP=
# Denylist de competidores separada por comas. Vacío = check no verificable.
RFP_COMPETITOR_NAMES=
# Base de conocimiento empresarial opcional como apoyo
RFP_KNOWLEDGE_ENABLED=false
