# ============================================================
# Brasaland API — Environment Variables Template
# Copy this file to .env locally: cp .env.example .env
# NEVER commit real credentials to Git.
# ============================================================

# Database URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE

# JWT Security
SECRET_KEY=replace-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password-reset JWT (must differ from SECRET_KEY in production)
PASSWORD_RESET_SECRET_KEY=replace-with-a-different-secret
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend delivery and public backoffice URL
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000

# Development only: include the reset URL in the API response
AUTH_DEBUG_RESET_LINKS=false

# TinyDB path (defaults to data/suppliers.json)
SUPPLIERS_DB_PATH=data/suppliers.json

# Telemetry ingestion endpoint (stub/collector)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# RAG — complete ONLY after confirming the student API contract with 4Geeks.
# Supported contract: embeddings-chat-v1 (documented in docs/rag/rag-design.md).
# Full endpoint URLs, dedicated model IDs, and keys have no defaults.
RAG_HTTP_CONTRACT=
RAG_EMBEDDING_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSION=
# float or base64_int8, exactly as confirmed by the provider
RAG_EMBEDDING_ENCODING=
RAG_GENERATION_URL=
RAG_GENERATION_MODEL=
RAG_GENERATION_API_KEY=
# Explicit experimental threshold required, then calibrate with evaluation.
RAG_MIN_SCORE=
RAG_TIMEOUT_SECONDS=30
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
