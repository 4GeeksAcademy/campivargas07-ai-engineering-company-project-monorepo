# ============================================================
# Brasaland API — Environment Variables Template
# Copy this file to .env locally: cp .env.example .env
# NEVER commit real credentials to Git.
# ============================================================

# Database URLs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE

# JWT Security
SECRET_KEY=replace-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# TinyDB path (defaults to data/suppliers.json)
SUPPLIERS_DB_PATH=data/suppliers.json
