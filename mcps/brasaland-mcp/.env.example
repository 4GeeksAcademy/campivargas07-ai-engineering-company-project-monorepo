# Brasaland MCP — configuración de ejemplo.
# Copia a .env (ignorado por Git) y completa con valores reales.
# NUNCA commitees credenciales ni tokens reales.

# --- Frontera 1: OAuth resource server (cliente -> MCP) ---
# Identificador público del recurso (RFC 8707) y `aud` esperado de los tokens.
# En Codespaces: URL HTTPS pública reenviada del puerto MCP terminada en /mcp.
MCP_RESOURCE_ID=https://TU-CODESPACE-9100.app.github.dev/mcp
# Issuer OIDC/OAuth 2.1 del proveedor (debe exponer discovery + JWKS).
MCP_AUTH_ISSUER=https://TU-PROVEEDOR-OIDC/
# oidc (OpenID Connect Discovery) | oauth (RFC 8414)
MCP_AUTH_SERVER_TYPE=oidc

# --- Frontera 2: MCP -> API de Brasaland (cuenta de servicio dedicada) ---
# URL interna del backend FastAPI. No exponer el backend públicamente.
BRASALAND_API_URL=http://127.0.0.1:8000
# Cuenta de servicio del MCP en Brasaland (crear vía flujo de registro/admin).
MCP_BACKEND_SERVICE_EMAIL=mcp-service@brasaland.example
MCP_BACKEND_SERVICE_PASSWORD=cambia-esto-por-un-seguro
MCP_BACKEND_TIMEOUT_SECONDS=5.0

# --- Servidor ---
# En Codespaces usar 0.0.0.0 para que el reenvío de puerto funcione.
MCP_HOST=127.0.0.1
MCP_PORT=9100
MCP_LOG_LEVEL=INFO
